import java.util.Scanner;

public class AdminMenu {

    public static void showMenu(Scanner sc) {

        while (true) {

            System.out.println("\n========== EASYMART ADMIN MENU ==========");
            System.out.println("1. Add Product");
            System.out.println("2. View Products");
            System.out.println("3. Manage Orders");
            System.out.println("4. Logout");
            System.out.print("Enter your choice: ");

            int choice = sc.nextInt();
            sc.nextLine();

            switch (choice) {

                case 1:
                    System.out.println("\nAdd Product Module");
                    break;

                case 2:
                    System.out.println("\nView Products Module");
                    break;

                case 3:
                    System.out.println("\nManage Orders Module");
                    break;

                case 4:
                    System.out.println("\nAdmin logged out successfully!");
                    return;

                default:
                    System.out.println("\nInvalid choice!");
            }
        }
    }
}
